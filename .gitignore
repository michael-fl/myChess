target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# Avoid ignoring Maven wrapper jar file (.jar files are usually ignored)
!/.mvn/wrapper/maven-wrapper.jar

.idea/
*.iml

db/
mychess-stderr.log

# Large non-versioned PGN test fixture, used by @Disabled benchmark tests
# in PgnTest / PGNImporterTest and by the manual OpeningDB import workflow.
src/test/resources/large.pgn

# Cutechess match artifacts at the project root: the test/ snapshot dir
# used to freeze a classpath while a long-running match is in flight,
# plus the testNN-* logs and PGNs the user saves per match. Both
# patterns are leading-slash-anchored so they do NOT swallow src/test/.
.claude/
/engines/
/versions/

/myChess-stderr*

# Python bytecode from the tools/ scripts (lichess-blunder-scan, probe-blunder,
# analyze-repetition-match). Regenerated on every run.
__pycache__/

# Texel tuning datasets: large, re-downloadable external data (~79 MB).
# Only the README with the fetch command is tracked; the data itself is not.
/tuning-data/*
!/tuning-data/README.md


