target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# Avoid ignoring Maven wrapper jar file (.jar files are usually ignored)
!/.mvn/wrapper/maven-wrapper.jar

.idea/
*.iml

db/
mychess-stderr.log

# Large local PGN fixture. Nothing references it any more: the two benchmarks that did were
# @Disabled precisely because it is not versioned, and on 2026-08-18 both were rewritten to
# generate their own archive into a @TempDir (PgnTest, PGNImporterTest). The OpeningDB import
# workflow reads its own hard-coded KingBase directory, not this file. Kept ignored so an
# existing local copy does not surface in git status — it can simply be deleted.
src/test/resources/large.pgn

# Cutechess match artifacts at the project root: the test/ snapshot dir
# used to freeze a classpath while a long-running match is in flight,
# plus the testNN-* logs and PGNs the user saves per match. Both
# patterns are leading-slash-anchored so they do NOT swallow src/test/.
.claude/
/engines/
/versions/

/myChess-stderr*

# Python bytecode from the tools/ scripts (lichess-blunder-scan, probe-blunder,
# analyze-repetition-match). Regenerated on every run.
__pycache__/

# Texel tuning datasets: large, re-downloadable external data (~79 MB).
# Only the README with the fetch command is tracked; the data itself is not.
/tuning-data/*
!/tuning-data/README.md



# Local working cache of the king-safety screen: 96% of it is recomputed from this
# repository's own code on every run, and a stored copy would go stale invisibly.
# The irreplaceable half is tracked as test-results/king-safety-stockfish-evals.jsonl.
test-results/king-safety-screen-cache.jsonl
