<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>michael-fl</groupId>
  <artifactId>my-chess</artifactId>
  <version>4.6.0-king-line-corner</version>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.jupiter.version>5.11.4</junit.jupiter.version>

    <!-- Pinned because mapdb 3.0.8 declares open version ranges for these; see
         dependencyManagement below. -->
    <guava.version>33.7.1-jre</guava.version>
    <eclipse.collections.version>13.0.0</eclipse.collections.version>
    <kotlin.version>1.2.71</kotlin.version>
  </properties>

  <!--
    Pin the dependencies mapdb resolves through open version ranges.

    mapdb 3.0.8 declares guava as [15.0,) and eclipse-collections as [7.0.0,) -
    unbounded, so Maven picks whatever is newest at build time. The build was
    therefore not reproducible: two `mvn package` runs on the same commit could
    produce different lib/ contents with an identical jar, and nothing in the
    output said so. It happened between 4.4.2 and 4.5.0, where guava moved
    33.6.0 -> 33.7.1 and pulled newer error_prone_annotations and jspecify with
    it.

    That matters most for docs/bench-history.md, whose whole method rests on an
    unchanged node signature proving neutrality. A silent library swap breaks the
    attribution of any comparison across releases, however unlikely it is that
    guava affects the search.

    kotlin-stdlib is [1.2.41,1.2.90) - bounded above, so it cannot drift far, but
    it is pinned for the same reason: a version in a build artifact should be a
    decision, not a timestamp.

    The values are the ones 4.5.0 was built and measured with (2463 games,
    2026-08-23). Bumping any of them is a deliberate act that belongs in its own
    commit, with a bench run to show it changed nothing.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.collections</groupId>
        <artifactId>eclipse-collections</artifactId>
        <version>${eclipse.collections.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.collections</groupId>
        <artifactId>eclipse-collections-api</artifactId>
        <version>${eclipse.collections.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.collections</groupId>
        <artifactId>eclipse-collections-forkjoin</artifactId>
        <version>${eclipse.collections.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-stdlib</artifactId>
        <version>${kotlin.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <!-- Provide JUnit 5 API -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- MapDB -->
    <dependency>
      <groupId>org.mapdb</groupId>
      <artifactId>mapdb</artifactId>
      <version>3.0.8</version>
    </dependency>  </dependencies>
  <build>
    <resources>
      <!-- Filter src/main/resources so version.properties picks up
           ${project.version} from this pom at build time. Other resources
           (e.g. chess960_fens.csv) contain no placeholders, so filtering
           passes them through unchanged. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>org.michaelfl.mychess.MyChessMain</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <!-- Copy runtime dependencies into target/dependency so mychess-uci.sh
           can run with a classpath that contains all required jars without
           depending on Maven at runtime. Bound to the package phase. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-runtime-deps</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/dependency</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>